{
  "manifest_version": 3,
  "name": "THEME.BY — IITP Moodle Theme",
  "version": "3.0.12",
  "description": "IIT Patna Moodle Theme update via css style injection.",
  
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://cet.iitp.ac.in/*"
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "THEME.BY"
  },

  "content_scripts": [
    {
      "matches": [
        "https://cet.iitp.ac.in/moodle/*"
      ],
      "js": [
        "js/engine/Utils.js",
        "js/engine/StorageManager.js",
        "js/engine/StorageManager.js",
        "js/engine/PageManager.js",
        "js/engine/ColorManager.js",
        "js/engine/BackgroundManager.js",
        "js/engine/ThemeLoader.js",
        "js/engine/ThemeManager.js",
        "js/engine/ThemeEngine.js",
        "js/engine/PageTransition.js",
        "js/content.js",
        "js/redirect.js"
      ],
      "run_at": "document_start"
    }
  ],


  "web_accessible_resources": [
    {
      "resources": [
        "shared/*.css",
        "shared/**/*.css",
        "themes/core/css/**/*.css",
        "themes/core/config/*.json",
        "themes/core/assets/**/*",
        "assets/**/*",
        "themes/core/js/**/*.js"
      ],
      "matches": [
        "https://cet.iitp.ac.in/*"
      ]
    }  
  ]
}
